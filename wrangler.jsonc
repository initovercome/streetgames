{
	// Worker + статика сайта. Имя должно совпадать с Worker'ом в Cloudflare (streetgames).
	"name": "streetgames",
	"main": "worker/index.js",
	"compatibility_date": "2025-06-01",
	"assets": {
		"directory": ".",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		// хранилище «sg» в Cloudflare: Storage & Databases → Workers KV
		{ "binding": "STATS", "id": "eb9783d16be940c68f39006e28d4df31" }
	]
}
